{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retrobit.dev/gtlauncher/world-v2.schema.json",
  "title": "GTLauncher portable world, version 2",
  "description": "Portable metadata and stable identity. Objects are reserved and must remain empty until both renderers support them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "world"],
  "properties": {
    "format": { "const": "gtlauncher-world" },
    "version": { "const": 2 },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "color", "objects"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$", "not": { "const": "base" } },
        "name": { "type": "string", "minLength": 1, "maxLength": 48, "pattern": "\\S" },
        "description": { "type": "string", "maxLength": 160 },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "objects": { "type": "array", "maxItems": 0 }
      }
    }
  }
}
