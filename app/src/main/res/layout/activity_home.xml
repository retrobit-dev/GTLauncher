<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/launcher_background"
    android:clipToPadding="false">

    <!-- The sky remains the full-screen, gesture-receiving home surface. -->
    <dev.retrobit.gtlauncher.WeatherSkyView
        android:id="@+id/home_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/blank_home_background"
        android:contentDescription="@string/blank_home_accessibility"
        android:importantForAccessibility="yes" />

    <!-- Launcher status is present in every world, including worlds without a character. -->
    <LinearLayout android:id="@+id/home_character_hud" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_gravity="top|left" android:layout_marginTop="18dp" android:layout_marginLeft="20dp" android:orientation="horizontal" android:clickable="false" android:focusable="false">
        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_character_hud" android:padding="3dp" android:src="@drawable/character_hud_portrait" android:scaleType="fitCenter" android:scaleX="-1" android:contentDescription="Potret karakter utama" />
        <LinearLayout android:layout_width="90dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:background="@drawable/bg_character_hud" android:orientation="vertical" android:padding="2dp"><LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:contentDescription="Health: 100 dari 100, sementara">
<ImageView android:layout_width="9dp" android:layout_height="9dp" android:src="@drawable/hud_stat_icon_health" android:importantForAccessibility="no" />
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="2dp" android:orientation="horizontal"><View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:background="@drawable/hud_stat_health" /><View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:background="@drawable/hud_stat_health" /><View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:background="@drawable/hud_stat_health" /><View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:background="@drawable/hud_stat_health" /><View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:background="@drawable/hud_stat_health" /><View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:background="@drawable/hud_stat_health" /><View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:background="@drawable/hud_stat_health" /><View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:background="@drawable/hud_stat_health" /><View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:background="@drawable/hud_stat_health" /><View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:background="@drawable/hud_stat_health" /></LinearLayout>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="2dp" android:text="100" android:textColor="#FFF1CC" android:textSize="5sp" android:fontFamily="@font/press_start_2p" android:includeFontPadding="false" android:importantForAccessibility="no" /></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:contentDescription="Stamina: 100 dari 100, sementara">
<ImageView android:layout_width="9dp" android:layout_height="9dp" android:src="@drawable/hud_stat_icon_stamina" android:importantForAccessibility="no" />
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="2dp" android:orientation="horizontal"><View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:background="@drawable/hud_stat_stamina" /><View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:background="@drawable/hud_stat_stamina" /><View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:background="@drawable/hud_stat_stamina" /><View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:background="@drawable/hud_stat_stamina" /><View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:background="@drawable/hud_stat_stamina" /><View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:background="@drawable/hud_stat_stamina" /><View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:background="@drawable/hud_stat_stamina" /><View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:background="@drawable/hud_stat_stamina" /><View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:background="@drawable/hud_stat_stamina" /><View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:background="@drawable/hud_stat_stamina" /></LinearLayout>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="2dp" android:text="100" android:textColor="#FFF1CC" android:textSize="5sp" android:fontFamily="@font/press_start_2p" android:includeFontPadding="false" android:importantForAccessibility="no" /></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:contentDescription="Makanan: 100 dari 100, sementara">
<ImageView android:layout_width="9dp" android:layout_height="9dp" android:src="@drawable/hud_stat_icon_food" android:importantForAccessibility="no" />
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="2dp" android:orientation="horizontal"><View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:background="@drawable/hud_stat_food" /><View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:background="@drawable/hud_stat_food" /><View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:background="@drawable/hud_stat_food" /><View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:background="@drawable/hud_stat_food" /><View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:background="@drawable/hud_stat_food" /><View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:background="@drawable/hud_stat_food" /><View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:background="@drawable/hud_stat_food" /><View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:background="@drawable/hud_stat_food" /><View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:background="@drawable/hud_stat_food" /><View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:background="@drawable/hud_stat_food" /></LinearLayout>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="2dp" android:text="100" android:textColor="#FFF1CC" android:textSize="5sp" android:fontFamily="@font/press_start_2p" android:includeFontPadding="false" android:importantForAccessibility="no" /></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:contentDescription="Air: 100 dari 100, sementara">
<ImageView android:layout_width="9dp" android:layout_height="9dp" android:src="@drawable/hud_stat_icon_water" android:importantForAccessibility="no" />
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="2dp" android:orientation="horizontal"><View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:background="@drawable/hud_stat_water" /><View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:background="@drawable/hud_stat_water" /><View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:background="@drawable/hud_stat_water" /><View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:background="@drawable/hud_stat_water" /><View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:background="@drawable/hud_stat_water" /><View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:background="@drawable/hud_stat_water" /><View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:background="@drawable/hud_stat_water" /><View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:background="@drawable/hud_stat_water" /><View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:background="@drawable/hud_stat_water" /><View android:layout_width="0dp" android:layout_height="6dp" android:layout_weight="1" android:background="@drawable/hud_stat_water" /></LinearLayout>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="2dp" android:text="100" android:textColor="#FFF1CC" android:textSize="5sp" android:fontFamily="@font/press_start_2p" android:includeFontPadding="false" android:importantForAccessibility="no" /></LinearLayout>
</LinearLayout>
    </LinearLayout>

    <!-- Phone and bag remain together on every world. -->
    <LinearLayout
        android:id="@+id/home_phone_slots"
        android:layout_width="112dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="12dp"
        android:translationX="134dp"
        android:orientation="horizontal">
        <ImageButton
            android:id="@+id/home_phone_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="5dp"
            android:background="@drawable/bg_date_hud_panel"
            android:src="@drawable/dock_phone"
            android:scaleType="fitCenter"
            android:contentDescription="@string/open_apps_drawer" />
        <ImageButton
            android:id="@+id/home_bag_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_date_hud_panel"
            android:padding="5dp"
            android:src="@drawable/dock_bag"
            android:scaleType="fitCenter"
            android:contentDescription="Tas — inventaris belum tersedia" />
        <View
            android:id="@+id/home_end_empty_slot"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_date_hud_panel"
            android:contentDescription="Slot paling kanan kosong"
            android:importantForAccessibility="yes" />
    </LinearLayout>

    <!-- Non-interactive device clock and estimated season. -->
    <LinearLayout
        android:id="@+id/home_date_hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|right"
        android:layout_marginTop="18dp"
        android:layout_marginRight="20dp"
        android:scaleX="0.75"
        android:scaleY="0.75"
        android:transformPivotY="0dp"
        android:clickable="false"
        android:focusable="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="41dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_date_hud_panel"
            android:layoutDirection="ltr"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/hud_time_panel"
                android:layout_width="83dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="start|center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp">
                <ImageView
                    android:id="@+id/hud_season_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@string/season_unknown"
                    android:src="@drawable/season_unknown" />
                <TextClock
                    android:id="@+id/hud_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:layout_marginStart="3dp"
                    android:fontFamily="@font/press_start_2p"
                    android:format12Hour="HH:mm"
                    android:format24Hour="HH:mm"
                    android:includeFontPadding="false"
                    android:textColor="#342B1E"
                    android:textSize="10sp" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#815A2E" />
            <LinearLayout
                android:id="@+id/hud_battery_panel"
                android:layout_width="83dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="start|center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp">
                <ImageView
                    android:id="@+id/hud_battery_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/hud_battery_unknown" />
                <TextView
                    android:id="@+id/hud_battery"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="right|center_vertical"
                    android:layout_marginStart="3dp"
                    android:fontFamily="@font/press_start_2p"
                    android:includeFontPadding="false"
                    android:text="--.--"
                    android:contentDescription="@string/battery_unknown"
                    android:textColor="#342B1E"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_date_hud_calendar"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="3dp"
            android:paddingTop="7dp"
            android:paddingEnd="3dp"
            android:paddingBottom="3dp">
            <TextClock
                android:id="@+id/hud_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/press_start_2p"
                android:format12Hour="MM/yy"
                android:format24Hour="MM/yy"
                android:includeFontPadding="false"
                android:textColor="#342B1E"
                android:textSize="6sp" />
            <TextClock
                android:id="@+id/hud_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/press_start_2p"
                android:format12Hour="d"
                android:format24Hour="d"
                android:includeFontPadding="false"
                android:textColor="#342B1E"
                android:textSize="13sp"
                android:textStyle="normal" />
            <TextClock
                android:id="@+id/hud_weekday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/press_start_2p"
                android:format12Hour="EEE"
                android:format24Hour="EEE"
                android:includeFontPadding="false"
                android:textColor="#342B1E"
                android:textSize="6sp"
                android:textStyle="normal" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/app_drawer_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#4D191E18"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">
      <LinearLayout
        android:id="@+id/app_drawer_window"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_app_drawer_window"
        android:clickable="true"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="@string/apps_title"
                android:fontFamily="@font/press_start_2p"
                android:textColor="#342B1E"
                android:textSize="12sp"
                android:textStyle="normal" />

            <TextView
                android:id="@+id/world_button"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_home_badge"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/world_button"
                android:textColor="@color/launcher_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/app_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 aplikasi"
                android:textColor="#6D604B"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/drawer_back"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_home_badge"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="×"
                android:textColor="@color/launcher_text"
                android:textSize="24sp"
                android:contentDescription="@string/close_apps_drawer" />
        </LinearLayout>

        <EditText
            android:id="@+id/search_apps"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_search"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="17dp"
            android:paddingEnd="17dp"
            android:selectAllOnFocus="false"
            android:singleLine="true"
            android:textColor="@color/launcher_text"
            android:textColorHint="@color/launcher_muted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/apps_section_label"
                android:textColor="#6D604B"
                android:textSize="11sp"
                android:textStyle="normal" />

            <TextView
                android:id="@+id/location_permission_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_home_badge"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:paddingStart="11dp"
                android:paddingTop="7dp"
                android:paddingEnd="11dp"
                android:paddingBottom="7dp"
                android:text="@string/location_permission_button"
                android:textColor="#F4F6F4"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/default_home_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_badge"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:paddingStart="11dp"
                android:paddingTop="7dp"
                android:paddingEnd="11dp"
                android:paddingBottom="7dp"
                android:text="@string/home_badge_set_default"
                android:textColor="#F4F6F4"
                android:textSize="9sp"
                android:textStyle="normal" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:overScrollMode="ifContentScrolls"
                android:scrollbars="none">

                <GridLayout
                    android:id="@+id/app_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alignmentMode="alignBounds"
                    android:columnCount="4"
                    android:paddingBottom="8dp"
                    android:useDefaultMargins="false" />
            </ScrollView>

            <TextView
                android:id="@+id/empty_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/empty_apps"
                android:textColor="#6D604B"
                android:textSize="14sp"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:text="@string/usage_hint"
            android:textColor="#6D604B"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/weather_attribution_source"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/weather_source_credit"
                android:textColor="#6D604B"
                android:textSize="9sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="·"
                android:textColor="#6D604B"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/weather_attribution_license"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/weather_license_credit"
                android:textColor="#6D604B"
                android:textSize="9sp" />
        </LinearLayout>
      </LinearLayout>
    </FrameLayout>
</FrameLayout>
