<?xml version="1.0" encoding="utf-8"?>
<!-- Square, stepped frame in the same earth-and-cream palette as the launcher. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle"><solid android:color="#76502C" /></shape></item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle"><solid android:color="#DBA34B" /></shape>
    </item>
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle"><solid android:color="#F5E1B0" /></shape>
    </item>
</layer-list>
